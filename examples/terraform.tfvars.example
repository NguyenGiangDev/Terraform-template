# ─── terraform.tfvars.example ─────────────────────────────────────────────────
# Copy file này thành terraform.tfvars và điền các giá trị thực tế.
# KHÔNG commit terraform.tfvars vào git (đã có trong .gitignore).
# Thường CI/CD sẽ generate file này tự động khi deploy.

# ─── Application ──────────────────────────────────────────────────────────────

app_name    = "reward-hub"
environment = "stg"
env         = "stg"
aws_region  = "ap-southeast-1"

# ─── Network ──────────────────────────────────────────────────────────────────

vpc_id = "vpc-0123456789abcdef0"

private_subnet_ids = [
  "subnet-0aaaaaaaaaaaaaaaa",
  "subnet-0bbbbbbbbbbbbbbbbb",
]

public_subnet_ids = [
  "subnet-0ccccccccccccccccc",
  "subnet-0ddddddddddddddddd",
]

# ─── ECS ──────────────────────────────────────────────────────────────────────

ecs_cluster_id   = "arn:aws:ecs:ap-southeast-1:890970452363:cluster/gotit-stg"
ecs_cluster_name = "gotit-stg"

# ─── ALB ──────────────────────────────────────────────────────────────────────

# ALB Listener ARN — stg dùng ALB staging, prod dùng ALB production
alb_listener_arn = "arn:aws:elasticloadbalancing:ap-southeast-1:890970452363:listener/app/gotit-stg-alb/abc123/def456"

# Security Group ID của ALB (để ECS task SG cho phép traffic vào từ ALB)
alb_security_group_id = "sg-0123456789abcdef0"

# ─── Container Images ─────────────────────────────────────────────────────────
# CI/CD inject sau bước tạo ECR (đọc từ terraform output ecr_repository_urls).

app_repository_url   = "890970452363.dkr.ecr.ap-southeast-1.amazonaws.com/stg-reward-hub-app"
nginx_repository_url = "890970452363.dkr.ecr.ap-southeast-1.amazonaws.com/stg-reward-hub-nginx"

# Docker image tag — CI/CD inject per deploy (commit SHA hoặc version tag)
image_tag = "abc1234f"

# ─── Resource Sizing (Optional overrides) ─────────────────────────────────────
# Uncomment để override default values (256 CPU, 512 MB, 1 instance)

# service_cpu = {
#   api    = 512
#   worker = 256
# }

# service_memory = {
#   api    = 1024
#   worker = 512
# }

# service_desired_count = {
#   api    = 2
#   worker = 1
# }

# ─── Tags ─────────────────────────────────────────────────────────────────────

tags = {
  Team    = "platform"
  Project = "reward-hub"
  Owner   = "backend-team"
}
